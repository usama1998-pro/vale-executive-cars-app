# Nest API (no trailing slash). Read by app.config.js → expo.extra.BASE_API_URL
#
# Android emulator → host machine:
#   BASE_API_URL=http://10.0.2.2:3001
# iOS simulator:
#   BASE_API_URL=http://localhost:3001
# Physical device on same Wi‑Fi as your PC:
#   BASE_API_URL=http://YOUR_PC_LAN_IP:3001
# Production:
#   BASE_API_URL=https://your-api.example.com
#
# Phone testing via ngrok (backend must be running on port 3001):
#   1. In backend/: npm run start:dev
#   2. ngrok http 3001   ← not 3000
#   3. Set BASE_API_URL to the https URL ngrok prints (no trailing slash)

BASE_API_URL=http://10.0.2.2:3001
